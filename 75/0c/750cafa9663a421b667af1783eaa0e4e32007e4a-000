      .zr-card-hover{transition:transform .16s cubic-bezier(.25,1,.5,1),filter .16s ease} .zr-card-hover:hover{transform:translateY(-2px);filter:drop-shadow(0 10px 22px rgba(0,0,0,0.14))}
