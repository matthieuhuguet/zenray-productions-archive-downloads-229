      /* ── RESPONSIVE (C217) : mobile <640 · tablette 640-1024 · desktop >1024 ── */
      /* Sidebar en OVERLAY sous 860px : flotte par-dessus le contenu, ne le pousse pas. */
      .zr-sidebar-overlay{position:fixed !important;top:0;left:0;height:100dvh !important;z-index:120;
        box-shadow:var(--zr-shadow-overlay);animation:zr-slide-in .22s cubic-bezier(.22,.61,.36,1);
        /* MOBILE : panneau quasi opaque (pas le verre translucide a 58%), sinon il "floute tout" le contenu au
           lieu d'etre un panneau lisible. Blur leger garde le grain liquid glass sans jank ni transparence. */
        background:var(--zr-bg-content) !important;backdrop-filter:blur(10px) saturate(180%) !important;-webkit-backdrop-filter:blur(10px) saturate(180%) !important}
      .zr-sidebar-overlay::before{opacity:.6}
      .zr-sidebar-backdrop{position:fixed;inset:0;z-index:110;background:rgba(0,0,0,0.32);
        backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);animation:zr-fade-in .2s ease}
      @keyframes zr-slide-in{from{transform:translateX(-100%)}to{transform:translateX(0)}}
      @keyframes zr-fade-in{from{opacity:0}to{opacity:1}}

      /* Drawers latéraux du Finder (favoris / inspecteur) sur écran étroit */
      .zr-drawer-backdrop{position:fixed;inset:0;z-index:130;background:rgba(0,0,0,0.32);
        backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px);animation:zr-fade-in .2s ease}

      /* P4 — zones qui scrollent dans un panneau en verre : on coupe le blur (recompose à chaque frame = jank mobile),
         fond opaque fort à la place. Posée sur les conteneurs overflowY:auto des drawers + sidebar overlay. */
      .zr-scroll-noblur{backdrop-filter:none !important;-webkit-backdrop-filter:none !important;background:var(--zr-glass-bg-strong) !important}
      .zr-path-columns-scroll::-webkit-scrollbar{display:none}
      .zr-liquid-normal::before{content:"";position:absolute;inset:0;border-radius:inherit;padding:1px;pointer-events:none;z-index:2;
        background:linear-gradient(135deg,rgba(255,255,255,.92),rgba(255,255,255,.24) 42%,rgba(0,0,0,.10));
        -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;
        mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);mask-composite:exclude}

      /* Tablette + mobile : zones de tap confortables (>=40px), pas de hover-only. */
      /* Tile Finder (GLOBAL, desktop inclus) : l'icône/vignette (img/svg) ne doit JAMAIS intercepter le clic
         ni démarrer un drag d'image natif. Sinon, en desktop, le clic/double-clic atterrit sur l'icône et le
         dossier ne s'ouvre pas (il fallait cliquer à côté). On rend ces éléments transparents aux pointeurs :
         tous les clics/double-clics atteignent le <button> de la tuile ; le drag du tile (porté par le bouton)
         continue de fonctionner. Cette règle était à tort confinée au @media mobile -> sortie en global. */
      .zr-treeitem img,.zr-treeitem svg{pointer-events:none;-webkit-user-drag:none;user-select:none}
      @media (max-width:1024px){
        .zr-tap{min-height:40px;display:flex;align-items:center;justify-content:center}
        .zr-treeitem,.zr-navitem{min-height:38px;display:flex;align-items:center}
        /* P3 — sur tactile, révéler les actions normalement cachées au hover (classe dédiée, pas un guess de style inline) */
        .zr-hover-action{visibility:visible !important;opacity:1 !important}
      }

      /* Mobile <640 : feuille blanche pleine largeur, marges réduites, md plus lisible. */
      @media (max-width:640px){
