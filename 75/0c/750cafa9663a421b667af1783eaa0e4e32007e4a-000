      /* Éditeur AVEC overlay (.zr-ph-custom = PageEditorBN) : on masque le natif, l'overlay React prend le relais. */
      .zr-ph-custom .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after{color:transparent!important;-webkit-text-fill-color:transparent!important}
      .zr-ph-letter{opacity:.45;animation:zr-ph-letter 2.4s linear infinite;will-change:opacity}
      @keyframes zr-ph-letter{0%{opacity:.45}50%{opacity:1}100%{opacity:.45}}
