@font-face {
  font-family: 'GT Super Display';
  src: url('fonts/GT-Super-Display-Bold.ttf') format('truetype');
  font-weight: 700;
  font-style: normal;
  font-display: swap;
}

/* Placeholder éditeur (BlockNote) : il est injecté au RUNTIME sur le pseudo `:before` des blocs vides marqués
   [data-is-empty-and-focused] (PAS [data-placeholder]) -> on cible CE sélecteur. !important bat la règle injectée.
   Gris foncé lisible en clair, clair en sombre (sinon texte d'invite quasi blanc, illisible). */
[data-is-empty-and-focused]:before,
[data-is-only-empty-block]:before,
[data-placeholder]:before,
.bn-editor [data-is-empty-and-focused]:before,
.bn-editor [data-is-only-empty-block]:before,
.bn-editor [data-placeholder]:before,
.bn-editor .is-empty:before,
.bn-editor .is-editor-empty:before { color: #1F1F1E !important; -webkit-text-fill-color: #1F1F1E !important; opacity: 1 !important; }
[data-color-scheme="dark"] [data-is-empty-and-focused]:before,
[data-color-scheme="dark"] [data-is-only-empty-block]:before { color: rgba(236,236,234,0.55) !important; }

/* PLACEHOLDER « lettre par lettre » : le natif (::after, texte insécable) est MASQUÉ ; un overlay React le remplace
   (1 span animé/lettre, vague d'opacité). Animation .zr-ph-letter définie aussi dans index.html. */
/* Éditeurs SANS overlay (Articles) : natif visible NOIR ; éditeur AVEC overlay (.zr-ph-custom) : natif masqué. */
.bn-editor .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after,
.bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after { color: #1F1F1E !important; -webkit-text-fill-color: #1F1F1E !important; opacity: 1 !important; }
.zr-dark .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after,
[data-color-scheme="dark"] .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after { color: rgba(236,236,234,0.62) !important; -webkit-text-fill-color: rgba(236,236,234,0.62) !important; }
.zr-ph-custom .bn-block-content:has(.ProseMirror-trailingBreak:only-child)::after { color: transparent !important; -webkit-text-fill-color: transparent !important; }
.zr-ph-letter { opacity: .45; animation: zr-ph-letter 2.4s linear infinite; will-change: opacity; }
@keyframes zr-ph-letter { 0% { opacity: .45 } 50% { opacity: 1 } 100% { opacity: .45 } }
@media (prefers-reduced-motion: reduce) { .zr-ph-letter { animation: none !important; opacity: .6 !important; } }

/* Bloc code (BlockNote) : deux bugs signalés par Matthieu 2026-07-12.
   1) Aucune marge entre blocs consécutifs -> deux blocs code l'un sous l'autre se touchaient (même fond gris,
      lisent comme UN SEUL bloc fusionné) -> margin-bottom.
   2) Le rayon d'arrondi (10px) était FIXE, donc identique sur un bloc court ou long -> jamais franchement une
      capsule. Mécanique CSS utilisée : un rayon proche de la MOITIÉ de la hauteur "1 ligne" (52px -> ~26px) se
      CLAMPE automatiquement à un plein stade/capsule tant que le bloc tient sur 1 ligne (52px de haut), puis
      redevient un simple rectangle arrondi dès qu'une 2e ligne apparaît (76px, le même rayon ne fait plus la
      moitié de la hauteur) -> aucune media query, aucun JS, le seul fait de fixer un rayon plus grand suffit.
   Padding latéral élargi en même temps (16px -> 22px) pour que le texte ne frôle jamais le bord incurvé. */
.bn-editor .bn-block-content[data-content-type="codeBlock"] {
  border-radius: 26px !important;
  padding: 14px 22px !important;
  margin-bottom: 8px !important;
}

/* E9 — ergonomie mobile (<=480px, iPhone 15 Pro ~390px). Purement additif : aucun effet hors telephone.
   jamais de scroll horizontal parasite ; medias bornes a la largeur ecran ; safe-area utilitaires. Les grilles
   Finder/Drive/Archives utilisent deja auto-fill minmax -> 1-2 colonnes a 390px, rien a forcer. */
/* spinner de chargement du lecteur vidéo (VideoPlayer2). */
@keyframes zr-spin { to { transform: rotate(360deg); } }

/* boutons du lecteur vidéo (VideoPlayer2, 2026-07-05) : feedback survol/appui façon YouTube — fondu léger
   au survol, petit "ping pong" (scale) à l'appui. Volontairement très simple, 2 règles seulement. Les
   styles inline (background, border-radius) posés par chaque bouton restent maîtres ; ces règles n'ajoutent
   que transition/hover/active, jamais de conflit de spécificité avec l'inline. */
.zr-ctrl-btn { transition: background-color var(--g9-timing, .35s) var(--g9-ease, ease), transform var(--g9-timing, .35s) var(--g9-ease, ease); }
.zr-ctrl-btn:hover { background-color: rgba(255,255,255,0.14); }

/* Le sous-menu contextuel Finder est rendu conditionnellement après un clic explicite. Le hover ne pilote
   jamais sa navigation : il ne conserve ici que le feedback visuel générique de .zr-treeitem. */
.zr-ctrl-btn:active { transform: scale(0.88); }
@media (prefers-reduced-motion: reduce) {
  .zr-ctrl-btn { transition: none !important; }
  .zr-ctrl-btn:active { transform: none !important; }
}

/* ── Matériau V9 (Memory/Design/ui-design/ui-components-zenray-v9.html, 2026-07-19) ──────────────
   Système Liquid Glass UNIQUE pour tous les composants refondus : lecteurs vidéo, players audio,
   recherche compacte, sidebar, barre Create, preview markdown. LIGHT est le défaut (:root),
   DARK vit sous .zr-dark (classe posée par App.jsx sur le conteneur racine — les portails montés
   hors de ce div doivent la reposer eux-mêmes). Rim light = gris-noir inversé, mêmes valeurs
   haut/bas (comportement V7 confirmé dans le fichier de design). --g9-timing 0.35s = durée
   par défaut des transitions de boutons/clics ("Fast interaction range", UI lente et premium).

   Liseré piloté par UN SEUL paramètre (2026-07-19, cf. Memory/Design/ui-design/ui-components-zenray-v10.html
   et son slider "Rim opacity") : --g9-rim-ratio (0 à 1) est l'unique valeur à changer pour retoucher
   l'intensité du liseré partout à la fois — plus jamais de rgba() individuels à traquer composant par
   composant. Les nombres de base (.72/.16/.085/.66 dark ; .46/.18/.10 light) sont ceux du fichier V10 à
   ratio=1 (100%), multipliés ici par calc(). Défaut de production = 0.20 (slider V10 par défaut = 0.35,
   Matthieu a demandé 20% pour l'UI réelle). En light, seul le liseré gris-noir varie avec le ratio ; le
   liseré noir extérieur (--g9-outer-line) n'existe qu'en dark et reste toujours transparent en light. */
:root {
  --g9-rim-ratio: 0.20;
  --g9-fg: rgba(25,27,31,.92);
  /* Fond du thème (2026-07-22) : sert la paire d'état ACTIF contrastée des boutons toggle (fond = --g9-fg,
     icône = --g9-bg) -> cercle sombre + icône claire en light, cercle blanc + icône sombre en dark. */
  --g9-bg: #fff;
  --g9-muted: rgba(25,27,31,.56);
  --g9-soft: rgba(25,27,31,.40);
  --g9-rail: rgba(25,27,31,.16);
  --g9-fill: rgba(25,27,31,.78);
  --g9-glass-a: rgba(255,255,255,.76);
  --g9-glass-b: rgba(229,233,239,.42);
  --g9-rim-main: rgb(34 37 43 / calc(0.46 * var(--g9-rim-ratio)));
  --g9-rim-soft: rgb(34 37 43 / calc(0.18 * var(--g9-rim-ratio)));
  --g9-rim-side: rgb(34 37 43 / calc(0.10 * var(--g9-rim-ratio)));
  --g9-outer-line: 0 0 0 0 transparent;
  --g9-elev-a: 0 14px 38px rgba(62,67,78,.13);
  --g9-elev-b: 0 3px 12px rgba(62,67,78,.08);
  --g9-timing: 0.35s;
  --g9-ease: cubic-bezier(.16,1,.3,1);
  /* Toolbars à contraste renforcé (Create path bar, Create searchbar, sidebar searchbar) : même verre
     que --g9-glass-a/-b, teinté gris-noir plus sombre pour mieux se détacher du fond. Un seul endroit
     à retoucher (le % de mix) pour ajuster les 3 surfaces à la fois -- retour Matthieu 2026-07-20. */
  --g9-toolbar-glass-a: color-mix(in srgb, var(--g9-glass-a) 80%, #1b1d21 20%);
  --g9-toolbar-glass-b: color-mix(in srgb, var(--g9-glass-b) 80%, #1b1d21 20%);
}
.zr-dark {
  --g9-fg: #fff;
  --g9-bg: #1c1c1e;
  --g9-muted: rgba(255,255,255,.62);
  --g9-soft: rgba(255,255,255,.46);
  --g9-rail: rgba(255,255,255,.26);
  --g9-fill: #fff;
  --g9-glass-a: rgba(255,255,255,.20);
  --g9-glass-b: rgba(255,255,255,.065);
  --g9-rim-main: rgb(255 255 255 / calc(0.72 * var(--g9-rim-ratio)));
  --g9-rim-soft: rgb(255 255 255 / calc(0.16 * var(--g9-rim-ratio)));
  --g9-rim-side: rgb(255 255 255 / calc(0.085 * var(--g9-rim-ratio)));
  --g9-outer-line: 0 0 0 .72px rgb(0 0 0 / calc(0.66 * var(--g9-rim-ratio)));
  --g9-elev-a: 0 14px 36px rgba(0,0,0,.27);
  --g9-elev-b: 0 3px 11px rgba(0,0,0,.15);
  --g9-toolbar-glass-a: color-mix(in srgb, var(--g9-glass-a) 68%, #000 32%);
  --g9-toolbar-glass-b: color-mix(in srgb, var(--g9-glass-b) 68%, #000 32%);
}

/* Crossfade play/pause 0.35s (section "Fast interaction range" du design) : les deux glyphes
   Apple restent montés, empilés dans une grille 1x1 ; l'état .is-playing ne fait varier que
   opacité + échelle, JAMAIS le layout — la taille du bouton est donc invariante entre lecture
   et pause (corrige aussi le "pop" de hauteur du mini-player signalé le 2026-07-19). */
.zr-pp { display: inline-grid; place-items: center; }
.zr-pp > span { grid-area: 1/1; display: grid; place-items: center; transition: opacity var(--g9-timing) var(--g9-ease), transform var(--g9-timing) var(--g9-ease); }
.zr-pp .zr-pp-play { opacity: 1; transform: scale(1); }
.zr-pp .zr-pp-pause { opacity: 0; transform: scale(.72); }
.zr-pp.is-playing .zr-pp-play { opacity: 0; transform: scale(.72); }
.zr-pp.is-playing .zr-pp-pause { opacity: 1; transform: scale(1); }
@media (prefers-reduced-motion: reduce) { .zr-pp > span { transition-duration: .01ms !important; } }

/* Lecteurs vidéo raw + MSE : "Playback overlay" du design V9. Les classes historiques zr-video-*
   sont conservées (zéro refonte de structure JSX) ; seule la RECETTE change — verre en dégradé
   135deg glass-a→glass-b, rim principal ±1px + doux ±2px + latéral ±1px, double élévation,
   blur 27px saturate 169%, plus aucun grain (noise V5 volontairement retiré, cf. design). */
.zr-video-glass,
.zr-video-seek-pill,
.zr-video-volume-pill,
.zr-video-options-pill,
.zr-video-settings-menu {
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-video-glass {
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  padding: 0;
  border: 0;
  border-radius: 999px;
  cursor: pointer;
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-video-glass:hover { filter: brightness(1.06); transform: scale(1.03); }
.zr-video-glass:active { transform: scale(.96); }
.zr-video-glass:disabled { cursor: default; opacity: .42; transform: none; }
.zr-video-controls {
  position: absolute; inset: 0;
  z-index: 3;
  padding: 22px;
  pointer-events: none;
  background: none;
  transition: opacity .2s ease;
}
.zr-video-controls > * { pointer-events: auto; }
.zr-video-top-left { position:absolute; top:22px; left:22px; display:flex; gap:12px; }
.zr-video-top-right { position:absolute; top:22px; right:22px; }
.zr-video-transport { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; gap:clamp(70px,12vw,150px); pointer-events:none; }
.zr-video-transport > * { pointer-events:auto; }
.zr-video-bottom-right { position:absolute; right:22px; bottom:92px; display:flex; align-items:center; gap:8px; }
.zr-video-bottom { position:absolute; right:18px; bottom:16px; left:18px; }
.zr-video-play-center { position:static; width:92px; height:92px; }
.zr-video-seek-pill {
  display: grid;
  box-sizing: border-box;
  grid-template-columns: 82px minmax(0,1fr) 94px;
  align-items: center;
  gap: 22px;
  width: 100%;
  height: 62px;
  padding: 0 26px;
  border-radius: 999px;
}
/* The timeline is also absolutely positioned with left + right in both video
   engines. Its intrinsic `width: 100%` would otherwise add those insets on top
   and clip the remaining-duration label at the right edge. */
.zr-video-bottom.zr-video-seek-pill {
  width: auto;
  min-width: 0;
}
.zr-video-seek,
.zr-video-volume {
  appearance: none;
  -webkit-appearance: none;
  width: 100%;
  height: 28px;
  margin: 0;
  cursor: pointer;
  background: transparent;
}
.zr-video-seek::-webkit-slider-runnable-track,
.zr-video-volume::-webkit-slider-runnable-track {
  height: 8px;
  border-radius: 999px;
  background:
    linear-gradient(to right, var(--g9-fill) 0 var(--zr-video-played, var(--zr-video-volume, 0%)), transparent var(--zr-video-played, var(--zr-video-volume, 0%)) 100%),
    linear-gradient(to right, color-mix(in srgb, var(--g9-fill) 45%, transparent) 0 var(--zr-video-buffered, var(--zr-video-volume, 0%)), var(--g9-rail) var(--zr-video-buffered, var(--zr-video-volume, 0%)) 100%);
}
.zr-video-volume::-webkit-slider-runnable-track { height: 3px; }
.zr-video-seek::-webkit-slider-thumb,
.zr-video-volume::-webkit-slider-thumb {
  width: 12px;
  height: 12px;
  margin-top: -2px;
  border: 0;
  border-radius: 999px;
  appearance: none;
  -webkit-appearance: none;
  background: var(--g9-fill);
  box-shadow: 0 1px 5px rgba(0,0,0,.34);
  opacity: 0;
  transition: opacity var(--g9-timing) var(--g9-ease);
}
.zr-video-volume::-webkit-slider-thumb { margin-top: -4.5px; }
.zr-video-seek:hover::-webkit-slider-thumb,
.zr-video-seek:focus-visible::-webkit-slider-thumb,
.zr-video-volume:hover::-webkit-slider-thumb,
.zr-video-volume:focus-visible::-webkit-slider-thumb { opacity: 1; }
.zr-video-seek::-moz-range-track,
.zr-video-volume::-moz-range-track { height: 8px; border-radius: 999px; background: var(--g9-rail); }
.zr-video-volume::-moz-range-track { height: 3px; }
.zr-video-seek::-moz-range-progress,
.zr-video-volume::-moz-range-progress { height: 8px; border-radius: 999px; background: var(--g9-fill); }
.zr-video-volume::-moz-range-progress { height: 3px; }
.zr-video-seek::-moz-range-thumb,
.zr-video-volume::-moz-range-thumb { width: 12px; height: 12px; border: 0; border-radius: 999px; opacity: 0; background: var(--g9-fill); box-shadow: 0 1px 5px rgba(0,0,0,.34); }
.zr-video-seek:hover::-moz-range-thumb,
.zr-video-seek:focus-visible::-moz-range-thumb,
.zr-video-volume:hover::-moz-range-thumb,
.zr-video-volume:focus-visible::-moz-range-thumb { opacity: 1; }
.zr-video-control-row { display: flex; min-width: 0; align-items: center; gap: 8px; color: var(--g9-fg); }
.zr-video-control-sm { width: 48px; height: 48px; }
.zr-video-control-md { width: 64px; height: 64px; }
.zr-video-volume-pill { display: flex; align-items: center; gap: 12px; width: 280px; height: 48px; padding: 0 16px 0 18px; border-radius: 999px; }
.zr-video-volume-pill .zr-video-volume { flex: 1; min-width: 0; }
.zr-video-volume-toggle { display: inline-grid; width: 32px; height: 32px; flex: 0 0 auto; place-items: center; padding: 0; color: var(--g9-fg); border: 0; background: transparent; cursor: pointer; }
.zr-video-time { min-width: 0; color: var(--g9-fg) !important; font-family: var(--zr-police-mono); font-size: var(--zr-ui-lg); font-weight: 400; font-variant-numeric: tabular-nums; letter-spacing: .01em; }
.zr-video-time:last-child { text-align: right; }
.zr-video-actions { position: relative; display: flex; align-items: center; gap: 8px; margin-left: auto; }
.zr-video-options-pill { display: inline-flex; box-sizing: border-box; align-items: center; gap: 4px; height: 48px; padding: 2px; border-radius: 999px; overflow: hidden; }
.zr-video-option-button { display: inline-grid; width: 44px; height: 44px; place-items: center; flex: 0 0 auto; padding: 0; color: var(--g9-fg); border: 0; border-radius: 999px; background: transparent; cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease); }
.zr-video-option-button:hover, .zr-video-option-button:focus-visible { background: color-mix(in srgb, var(--g9-fg) 14%, transparent); outline: none; }
.zr-video-settings-menu { position: absolute; right: 0; bottom: 56px; min-width: 152px; max-height: 300px; overflow: auto; padding: 6px; color: var(--g9-fg); border-radius: 18px; }
@media (max-width: 700px) {
  .zr-video-controls { padding: 12px; }
  .zr-video-top-left { top:12px; left:12px; }.zr-video-top-right { top:12px; right:12px; }
  .zr-video-bottom-right { right:12px; bottom:66px; }.zr-video-bottom { right:12px; bottom:10px; left:12px; }
  .zr-video-seek-pill { grid-template-columns: 62px minmax(0,1fr) 70px; gap: 14px; height: 56px; padding: 0 18px; }
  .zr-video-control-row { gap: 5px; }
  .zr-video-control-sm { width: 38px; height: 38px; }
  .zr-video-control-md { width: 42px; height: 42px; }
  .zr-video-volume-pill { width: 148px; height: 38px; padding: 0 10px 0 12px; gap: 6px; }
  .zr-video-volume-toggle { width: 28px; height: 28px; }
  .zr-video-time { font-size: var(--zr-ui-sm); }
  .zr-video-options-pill { height: 38px; padding: 2px; }
  .zr-video-option-button { width: 34px; height: 34px; }
  .zr-video-play-center { width:72px; height:72px; }
  .zr-video-transport { gap:24px; }
}
@media (prefers-reduced-motion: reduce) {
  .zr-video-glass, .zr-video-controls { transition: none; }
}

@media (max-width: 480px) {
  html, body { -webkit-text-size-adjust: 100%; overflow-x: hidden; }
  img, video, canvas { max-width: 100%; }
  .zr-safe-bottom { padding-bottom: calc(12px + env(safe-area-inset-bottom)); }
  .zr-safe-top { padding-top: env(safe-area-inset-top); }
}

/* "Compact search sidebar" V9 (design ui-components-zenray-v9.html) : recherche multi-source de la
   sidebar. Surfaces search + drop en matériau V9 (verre dégradé + rim + élévations, deux thèmes via
   --g9-*). Un seul jeu de classes pour les deux états replié/déplié (SearchGroup) : seule la liste de
   résultats + la pagination + le sens du chevron changent, jamais le style. */
.zr-sbs-search,
.zr-sbs-drop {
  position: relative;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-sbs-search { display: flex; align-items: center; gap: 7px; height: 36px; padding: 0 12px; border-radius: 999px; overflow: hidden; }
.zr-sbs-search input { position: relative; z-index: 1; min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--g9-fg); font: 400 var(--zr-ui-lg)/1 var(--zr-police-sans); }
.zr-sbs-search input::placeholder { color: var(--g9-muted); }
.zr-sbs-drop { margin-top: 4px; padding: 10px 8px; border-radius: 16px; display: flex; flex-direction: column; overflow: hidden; max-height: 320px; overflow-y: auto; }
.zr-sbs-group { position: relative; z-index: 1; padding: 7px 4px; }
.zr-sbs-group + .zr-sbs-group { border-top: 1px solid color-mix(in srgb, var(--g9-fg) 10%, transparent); }
.zr-sbs-group-head { display: flex; align-items: center; justify-content: space-between; padding: 0 2px 3px; }
.zr-sbs-group-head h4 { margin: 0; color: var(--g9-soft); font: 400 var(--zr-ui-sm)/1 var(--zr-police-sans); text-transform: uppercase; letter-spacing: .05em; }
.zr-sbs-chevron { width: 22px; height: 20px; display: grid; place-items: center; background: transparent; border: 0; cursor: pointer; color: var(--g9-muted); transition: transform var(--g9-timing) var(--g9-ease); }
.zr-sbs-chevron.up { transform: rotate(180deg); }
.zr-sbs-row { display: grid; grid-template-columns: 34px minmax(0,1fr) 22px; align-items: center; gap: 9px; width: 100%; padding: 5px 2px; border-radius: 8px; border: 0; background: transparent; text-align: left; cursor: pointer; color: inherit; transition: background-color var(--g9-timing) var(--g9-ease); }
.zr-sbs-row:hover { background: color-mix(in srgb, var(--g9-fg) 8%, transparent); }
.zr-sbs-thumb { width: 34px; height: 20px; border-radius: 4px; object-fit: cover; background: color-mix(in srgb, var(--g9-fg) 14%, transparent); flex-shrink: 0; }
.zr-sbs-thumb.round { width: 22px; height: 22px; border-radius: 5px; }
.zr-sbs-row strong { display: block; color: var(--g9-fg); font: 400 var(--zr-ui-md)/1.25 var(--zr-police-sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-sbs-row small { display: block; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1.3 var(--zr-police-sans); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.zr-sbs-add { width: 22px; height: 22px; border-radius: 999px; display: grid; place-items: center; background: transparent; border: 0; color: var(--g9-muted); cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }
.zr-sbs-add:hover { background: color-mix(in srgb, var(--g9-fg) 14%, transparent); color: var(--g9-fg); }
.zr-sbs-note { padding: 4px 2px; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1.3 var(--zr-police-sans); }
.zr-sbs-pagination { display: flex; align-items: center; justify-content: flex-end; gap: 8px; padding: 6px 4px 0; color: var(--g9-muted); font: 400 var(--zr-ui-sm)/1 var(--zr-police-mono); }
.zr-sbs-page-btn { width: 22px; height: 20px; display: grid; place-items: center; background: transparent; border: 0; color: inherit; cursor: pointer; }
.zr-sbs-page-btn:disabled { opacity: .35; cursor: default; }
/* Variante pilule de recherche de la Sidebar left (design workspace-search : h48, gap 12, icône 18). */
/* HAUTEUR RAMENÉE À CELLE DE LA CLASSE DE BASE (2026-07-31, retour Matthieu « la search bar reste
   trop grosse »). Cette variante imposait 48px là où `.zr-sbs-search` en vaut 36 : un tiers de plus
   que la même barre partout ailleurs dans l'application, sans raison écrite nulle part. L'écart se
   voyait surtout à côté de l'engrenage, qui paraissait alors désaligné ; corriger l'alignement seul
   ne réglait rien, puisque la cause était la hauteur. Gap et padding suivent la même proportion. */
.zr-sbs-search--sidebar { height: 36px; gap: 10px; padding: 0 14px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }
.zr-sbs-search--sidebar input { font-size: var(--zr-ui-sm); font-weight: 400; }

/* ── "Sidebar left" V9 (design ui-components-zenray-v9.html, section workspace-sidebar) ──────────
   La classe s'AJOUTE à .zr-liquid sur l'aside (l'ancrage du PlayerBar cherche aside.zr-liquid — ne
   jamais retirer cette classe) et surcharge son verre : dégradé NEUTRE charbon en dark (fix V9
   anti-vert : glass-a .135 / glass-b .045), laiteux en light. Le liseré ::before de zr-liquid est
   remplacé par le rim V9 en box-shadow. */
aside.zr-ws-sidebar {
  --ws-side-a: rgba(255,255,255,.78);
  --ws-side-b: rgba(226,230,235,.54);
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--ws-side-a), var(--ws-side-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
/* DARK : redéclarer background + box-shadow ICI, pas seulement les variables. Diagnostic DOM
   2026-07-19 : `.zr-dark .zr-liquid` (index.html, spécificité 0,2,0) BAT `aside.zr-ws-sidebar`
   (0,1,1) et imposait ses vieux insets 1.5px + fond plat rgba(31,31,30,.5) -> liserés haut/bas
   faux en dark. Ce sélecteur (0,2,1) reprend la main sans toucher aux autres .zr-liquid. */
.zr-dark aside.zr-ws-sidebar,
aside.zr-ws-sidebar.zr-ws-sidebar--dark {
  --ws-side-a: rgba(255,255,255,.135);
  --ws-side-b: rgba(255,255,255,.045);
  background: linear-gradient(135deg, var(--ws-side-a), var(--ws-side-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
}
aside.zr-ws-sidebar::before { display: none; }

/* ── LE LISERÉ DE LA SIDEBAR, SEUL (2026-08-21) ──────────────────────────────────────────────────
   Matthieu voulait ce liseré-ci sur les groupes de la galerie, et j'avais posé `zr-liquid-rim` à la
   place : « tu commences à ajouter plein d'effet c'est moche ». Il avait raison, ce sont deux
   familles opposées. `zr-liquid-rim` est un BISEAU pour carte opaque — highlight 1,5px, ombre
   interne, halo, plus une ombre portée de 32px. Celui-ci est un FILET, et rien d'autre : à
   --g9-rim-ratio 0.20, la ligne du haut vaut rgba(255,255,255,.144) en sombre. On le voit à peine,
   et c'est exactement le but.

   Extrait de `aside.zr-ws-sidebar` SANS ses deux ombres d'élévation (--g9-elev-a/-b, 14px et 3px de
   diffusion) : elles font sens sous un panneau qui flotte au-dessus de toute la page, jamais sous
   une tuile de 200px posée dans une grille, où elles salissent la grille entière. Le reste est
   identique au caractère près, et les jetons --g9-rim-* vivant sur :root et .zr-dark, le liseré
   suit le thème tout seul. */
.zr-ws-rim {
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side);
}
.zr-ws-top { min-height: 25px; display: flex; justify-content: flex-end; align-items: center; padding: 0 4px; }
.zr-ws-bare { width: 28px; height: 28px; padding: 0; display: grid; place-items: center; border: 0; border-radius: 8px; color: var(--g9-muted); background: transparent; cursor: pointer; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }
.zr-ws-bare:hover { background: color-mix(in srgb, var(--g9-fg) 7%, transparent); color: var(--g9-fg); }
/* Typo sidebar : consigne Matthieu 2026-07-19 (PRIME sur le design 17px/400) — fonts beaucoup
   plus petites et fines : items 13.5px/300 (jamais plus gras que 300), headings mono 10px. */
.zr-ws-heading { min-height: 24px; display: flex; align-items: center; gap: 8px; width: 100%; text-align: left; padding: 0 10px; margin: 9px 0 2px; border: 0; background: transparent; cursor: pointer; color: var(--g9-soft); font: 600 var(--zr-ui-xs)/1 var(--zr-police-sans); letter-spacing: .04em; text-transform: uppercase; }
/* Le chevron passe APRÈS le texte (2026-08-16). Il ouvrait la ligne et décalait donc chaque rubrique
   d'une quinzaine de pixels vers la droite, si bien qu'aucune ne s'alignait sur les items qu'elle coiffe.
   Une seule règle suffit et ne touche pas au JSX, qui déclare ce bouton à deux endroits : le libellé est
   un nœud de texte nu, donc un flex item anonyme d'ordre 0 que rien ne peut réordonner ; il suffit de
   pousser le seul élément réel de la ligne, l'icône, en ordre 1. Le texte démarre alors au padding de
   10 px, exactement celui des items. */
.zr-ws-heading > * { order: 1; }
/* Les RUBRIQUES de la sidebar (TOOLS, CREATE, GALLERY, APPS, SYSTEM), style simple et définitif après un
   passage par le mono puis par la serif : la même police que les items, en petites capitales. Trois valeurs
   seulement, et chacune répond à une raison. La graisse 600 détache la rubrique de ses items en 400 sans
   avoir besoin d'être plus grande. La taille descend d'un palier sous celle des items, ce qui suffit à dire
   la hiérarchie. Et l'interlettrage reste à .04em, juste de quoi aérer des capitales, là où les .16em hérités
   du mono écartaient les lettres au point qu'on lisait le mot par morceaux. */
.zr-ws-item { min-height: 26px; display: flex; align-items: center; gap: 7px; width: 100%; text-align: left; padding: 0 10px; border: 0; border-radius: 11px; background: transparent; cursor: pointer; color: var(--g9-fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-md); font-weight: 400; letter-spacing: -.015em; transition: background-color var(--g9-timing) var(--g9-ease), color var(--g9-timing) var(--g9-ease); }
.zr-ws-item:hover { background: color-mix(in srgb, var(--g9-fg) 6%, transparent); }
.zr-ws-item.active { color: #0a84ff; background: rgba(10, 132, 255, .13); }

/* ── "Create path bar + empty folders overlay" V9 (design workspace-shell/toolbar/blank) ─────────
   Le stage Finder devient le shell (verre teinté par thème, radius 26, padding 10) ; la barre est une
   GRILLE de quatre surfaces séparées (path pill · searchbar pill · bouton ⋯ · bouton + New bleu),
   plus une pilule englobante ; la zone dossiers est le "blank" (verre atténué, radius 20). */
.zr-ws-shell {
  /* MÊMES valeurs de verre que aside.zr-ws-sidebar (retour Matthieu 2026-07-20 : "le fond de Create et
     celui de la sidebar devraient logiquement être identiques puisque le HTML les traite pareil" -- le
     :is() du fichier v14 donne à workspace-sidebar ET workspace-shell le même glass-a/-b). Avant : le
     shell avait son propre couple (dark charbon opaque .48/.76) très différent de la sidebar. */
  --ws-shell-a: rgba(255,255,255,.78);
  --ws-shell-b: rgba(226,230,235,.54);
  border-radius: 26px !important;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--ws-shell-a), var(--ws-shell-b)) !important;
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b) !important;
  backdrop-filter: blur(27px) saturate(169%) !important;
  -webkit-backdrop-filter: blur(27px) saturate(169%) !important;
}
.zr-dark .zr-ws-shell { --ws-shell-a: rgba(255,255,255,.135); --ws-shell-b: rgba(255,255,255,.045); }
.zr-ws-toolbar { display: grid; grid-template-columns: minmax(0,1fr) minmax(140px,300px) 42px auto; align-items: center; gap: 9px; }
.zr-ws-path,
.zr-ws-searchbar {
  box-sizing: border-box;
  height: 42px;
  border-radius: 999px;
  display: flex;
  align-items: center;
  min-width: 0;
  color: var(--g9-muted);
  font-size: var(--zr-ui-md);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
}
.zr-ws-path { padding: 0 13px 0 16px; gap: 9px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }
.zr-ws-searchbar { padding: 0 15px; gap: 9px; background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b)); }
.zr-ws-searchbar input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: var(--g9-fg); font-size: var(--zr-ui-xs); font-weight: 400; }
.zr-ws-searchbar input::placeholder { color: var(--g9-muted); opacity: .8; }
/* Toggle "Search" cachable (2026-07-19) : chevron discret dans la pilule ouverte ; pilule compacte
   texte "Search" quand repliée -- même logique cachable que les zones Create/Apps/System. */
.zr-ws-search-toggle { flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px; border: 0; background: transparent; color: var(--g9-muted); cursor: pointer; padding: 0; }
.zr-ws-search-toggle:hover { color: var(--g9-fg); }
.zr-ws-search-toggle-closed { justify-self: start; width: fit-content; height: 42px; padding: 0 15px; border-radius: 999px; color: var(--g9-fg); font-family: var(--zr-police-sans); font-size: var(--zr-ui-xs); font-weight: 400;
  background: linear-gradient(135deg, var(--g9-toolbar-glass-a), var(--g9-toolbar-glass-b));
  box-shadow: var(--g9-outer-line), inset 0 1px 0 var(--g9-rim-main), inset 0 -1px 0 var(--g9-rim-main), inset 0 2px 0 var(--g9-rim-soft), inset 0 -2px 0 var(--g9-rim-soft), inset 1px 0 0 var(--g9-rim-side), inset -1px 0 0 var(--g9-rim-side), var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%); -webkit-backdrop-filter: blur(27px) saturate(169%);
}
/* Cartes Skills (App.jsx SkillCardRow, 2026-07-19) : vivaient encore sur l'ancien .zr-liquid (verre
   générique hors du système à un seul paramètre) -- retour Matthieu "cohérence design", même recette
   V9/rim 20% que le reste (Create path bar, sidebar, players). */
.zr-skill-card {
  border: 0; cursor: pointer; border-radius: 22px; padding: 14px 16px;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    var(--g9-elev-a),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
  transition: transform var(--g9-timing) var(--g9-ease);
}
.zr-skill-card:hover { transform: scale(1.008); }
.zr-skill-card:active { transform: scale(.992); }
.zr-ws-more-btn {
  box-sizing: border-box;
  width: 42px; height: 42px; min-height: 42px; padding: 0; flex: 0 0 42px;
  display: grid; place-items: center;
  border: 0; border-radius: 999px; cursor: pointer;
  color: var(--g9-fg);
  background: linear-gradient(135deg, var(--g9-glass-a), var(--g9-glass-b));
  box-shadow:
    var(--g9-outer-line),
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    var(--g9-elev-b);
  backdrop-filter: blur(27px) saturate(169%);
  -webkit-backdrop-filter: blur(27px) saturate(169%);
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-ws-more-btn:hover { filter: brightness(1.06); }
.zr-ws-more-btn:active { transform: scale(.95); }
/* + New : bleu exact du design (#3b82f7), contenu réellement centré, rim par thème. */
.zr-ws-new-btn {
  box-sizing: border-box;
  width: 112px; min-width: 112px; height: 42px; min-height: 42px; padding: 0 15px; flex: 0 0 112px;
  display: inline-flex; align-items: center; justify-content: center; gap: 7px;
  border: 0; border-radius: 999px; cursor: pointer;
  line-height: 1; white-space: nowrap;
  color: #fff !important;
  background: #3b82f7 !important;
  font-size: var(--zr-ui-md); font-weight: 400;
  box-shadow:
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    0 8px 23px rgba(59,130,247,.24);
  transition: transform var(--g9-timing) var(--g9-ease), filter var(--g9-timing) var(--g9-ease);
}
.zr-dark .zr-ws-new-btn {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.46),
    inset 0 -1px 0 rgba(255,255,255,.46),
    inset 0 2px 0 rgba(255,255,255,.14),
    inset 0 -2px 0 rgba(255,255,255,.14),
    0 8px 23px rgba(59,130,247,.28);
}
.zr-ws-new-btn:hover { filter: brightness(1.07); }
.zr-ws-new-btn:active { transform: scale(.97); }
.zr-ws-blank {
  --ws-blank-a: rgba(255,255,255,.55);
  --ws-blank-b: rgba(230,233,238,.42);
  border-radius: 20px;
  overflow: hidden;
  background: linear-gradient(135deg, var(--ws-blank-a), var(--ws-blank-b));
  box-shadow:
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    0 10px 28px rgba(62,67,78,.08),
    0 2px 8px rgba(62,67,78,.05);
}
.zr-dark .zr-ws-blank {
  --ws-blank-a: rgba(27,32,35,.72);
  --ws-blank-b: rgba(25,22,20,.78);
  box-shadow:
    inset 0 1px 0 var(--g9-rim-main),
    inset 0 -1px 0 var(--g9-rim-main),
    inset 0 2px 0 var(--g9-rim-soft),
    inset 0 -2px 0 var(--g9-rim-soft),
    inset 1px 0 0 var(--g9-rim-side),
    inset -1px 0 0 var(--g9-rim-side),
    0 10px 28px rgba(0,0,0,.16),
    0 2px 8px rgba(0,0,0,.11);
}
@media (max-width: 900px) {
  .zr-ws-toolbar { grid-template-columns: minmax(0,1fr) 42px auto; }
  .zr-ws-searchbar { display: none; }
}

/* ── Badge play des tuiles audio/playlist (Create, 2026-07-20) ────────────────────────────────────
   Clic = lecture immédiate dans le mini-player global (pas d'ouverture de ZenRay Audio). Au survol,
   un arc blanc tourne autour du rond façon aiguille de chargement -- un tour en 0.35s (la durée
   d'animation standard du site), en boucle tant que le curseur reste dessus. Arc blanc dans les deux
   thèmes : le badge lui-même est toujours sombre (rgba(18,18,20,.62)). */
.zr-play-badge { position: relative; }
.zr-play-badge::after {
  content: '';
  position: absolute;
  inset: -3px;
  border-radius: 999px;
  border: 1.5px solid transparent;
  border-top-color: #fff;
  opacity: 0;
  pointer-events: none;
  transition: opacity .15s ease;
}
.zr-play-badge:hover::after { opacity: 1; animation: zr-play-badge-spin .35s linear infinite; }
@keyframes zr-play-badge-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .zr-play-badge:hover::after { animation: none; } }


/* ── LE CORPS DE PAGE ─────────────────────────────────────────────────────────
   Deux fautes payées ici, écrites pour ne pas les rejouer. La première : une garde « si la classe n'est pas
   déjà dans le fichier » a sauté l'écriture de la règle, parce que `.bn-block-content` y figurait ailleurs —
   la variable existait donc sans que rien ne la consomme. La seconde : BlockNote pose lui-même `font-size`
   sur `.bn-block-content`, et une règle de même spécificité perdait en silence. On cible donc les blocs PAR
   LEUR TYPE, l'attribut apportant la spécificité qui manquait, et on laisse les TITRES tranquilles, qui
   tirent leur taille de leur niveau. Le markdown déjà rendu suit la même variable, sinon un aperçu et sa page
   n'auraient pas la même taille de texte. */
.bn-block-content[data-content-type="paragraph"],
.bn-block-content[data-content-type="bulletListItem"],
.bn-block-content[data-content-type="numberedListItem"],
.bn-block-content[data-content-type="checkListItem"],
.bn-block-content[data-content-type="quote"],
.bn-block-content[data-content-type="toggleListItem"] { font-size: var(--zr-corps-editeur); line-height: 1.62; font-weight: var(--zr-corps-poids); }

.md-body, .md-body p, .md-body li, .md-body blockquote { font-size: var(--zr-corps-editeur); line-height: 1.62;
  font-weight: var(--zr-corps-poids); }

/* ── LES PALIERS D'ÉCRAN ────────────────────────────────────────────────────────
   UN SEUL nombre change par palier, et toute l'échelle suit. Ces règles vivent ICI et pas dans le bloc de
   premier rendu d'index.html pour une raison de cascade : ce fichier est chargé APRÈS lui, donc sa déclaration
   simple `:root { --zr-corps-editeur: 18px }` écraserait n'importe quelle media query écrite là-bas. C'est
   d'ailleurs ce qui se passait : l'ancien `.md-body { font-size: var(--zr-ui-2xl) }` de la media query mobile était mort,
   et le téléphone affichait bel et bien le corps de bureau. */
@media (max-width: 1024px) { :root { --zr-corps-editeur: 16px; } }
@media (max-width: 640px) {
  :root {
    /* La taille reste celle du palier précédent ; seule l'ÉCHELLE se resserre, le titre restant dominant
       sans occuper trois lignes sur une colonne de 390 px. */
    --zr-echelle-1: 1.72;
    --zr-echelle-2: 1.42;
    --zr-echelle-3: 1.22;
    --zr-echelle-4: 1.08;
  }
}

/* ── LES TITRES DE L'ÉDITEUR, ALIGNÉS SUR CEUX DE LA PAGE ───────────────────────
   BlockNote pilote la taille de ses titres par une propriété personnalisée `--level` (3em, 2em, 1.3em, 1em,
   .9em, .8em) que consomme sa propre règle `font-size: var(--level)`. On se branche donc sur CE paramètre
   plutôt que d'écrire une taille par-dessus : la mécanique reste la sienne, les valeurs deviennent les nôtres.
   Le préfixe `.bn-editor` ajoute la classe qui fait gagner la spécificité quel que soit l'ordre des feuilles.
   Deux défauts corrigés au passage, tous deux hérités des valeurs par défaut : un h4 exactement de la taille
   du corps, et des h5/h6 plus PETITS que lui, donc des titres qui n'en avaient plus l'air. */
.bn-editor .bn-block-content[data-content-type="heading"] { --level: var(--zr-titre-1); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="2"] { --level: var(--zr-titre-2); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="3"] { --level: var(--zr-titre-3); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="4"] { --level: var(--zr-titre-4); }
.bn-editor .bn-block-content[data-content-type="heading"][data-level="5"],
.bn-editor .bn-block-content[data-content-type="heading"][data-level="6"] { --level: var(--zr-corps-editeur); }
/* Le `font-weight: 700` de BlockNote vit sur un sélecteur à cinq classes : `!important` est ici le moyen le
   plus court de reprendre la main, et c'est déjà la convention du fichier pour l'éditeur. 600 plutôt que 700
   parce que la fonte est variable et que le demi-gras suffit à détacher un titre sans l'alourdir. */
.bn-editor .bn-block-content[data-content-type="heading"] { font-weight: var(--zr-titre-poids) !important; }


/* ══════════════════════════════════════════════════════════════════════════════════════════════
   COUCHE DE VITRINE — n'appartient PAS à ZenRayProgress. C'est le chrome de l'atlas lui-même.
   Tout ce qui est au-dessus est extrait du projet ; tout ce qui est ici sert à le MONTRER.
   ══════════════════════════════════════════════════════════════════════════════════════════════ */

/* Le projet pose son fond sur <body>, et assombrit toute la page dès qu'un .zr-dark existe quelque
   part. Dans l'atlas, clair et sombre cohabitent côte à côte : cette règle rendrait le volet clair
   faux. On neutralise donc les trois règles de fond du projet, et on redonne à CHAQUE scène son
   propre fond — le verre a besoin de quelque chose à réfracter, sinon l'effet est invisible. */
body::before, body::after, body:has(.zr-dark)::after { display: none !important; }
body { background: #d9d9d6 !important; margin: 0; padding: 28px 24px 60px;
       font-family: var(--zr-police-sans); }

.atlas-tete { max-width: 1180px; margin: 0 auto 22px; }
.atlas-tete h1 { margin: 0 0 6px; font: 350 30px/1.2 var(--zr-police-serif); color: #1F1F1E; }
.atlas-tete p  { margin: 0 0 10px; font: 400 var(--zr-ui-lg)/1.5 var(--zr-police-sans);
                 color: #555552; max-width: 68ch; }
.atlas-source  { display: inline-block; padding: 4px 10px; border-radius: 7px;
                 background: rgba(0,0,0,.06); color: #555552;
                 font: 400 var(--zr-ui-xs)/1.4 var(--zr-police-mono); }
.atlas-retour  { display: inline-block; margin-bottom: 14px; color: #0A84FF; text-decoration: none;
                 font: 400 var(--zr-ui-sm) var(--zr-police-sans); }
.atlas-retour:hover { text-decoration: underline; }

/* LES DEUX FONDS, CÔTE À CÔTE ET NON NÉGOCIABLES. La moitié des défauts de ce projet ne se
   voyaient que dans un seul thème : un liseré juste en clair et faux en sombre, un texte lisible
   d'un côté seulement. Les mettre l'un à côté de l'autre les rend impossibles à manquer. */
.atlas-duo { max-width: 1180px; margin: 0 auto; display: grid;
             grid-template-columns: repeat(auto-fit, minmax(430px, 1fr)); gap: 18px; }
.atlas-volet { border-radius: 18px; overflow: hidden; box-shadow: 0 8px 30px -10px rgba(0,0,0,.22); }
.atlas-volet h2 { margin: 0; padding: 11px 16px;
                  font: 400 var(--zr-ui-xs)/1 var(--zr-police-mono);
                  letter-spacing: .09em; text-transform: uppercase; }
.atlas-volet:not(.zr-dark) h2 { background: #fafaf8; color: #8a8a86; border-bottom: 1px solid #e6e6e2; }
.atlas-volet.zr-dark h2 { background: #232322; color: #8a8a86; border-bottom: 1px solid #3a3a38; }

/* La scène porte le fond réfractable, en dur : c'est elle le substrat du verre. */
.atlas-scene { position: relative; isolation: isolate; padding: 30px 26px; min-height: 120px;
               display: flex; flex-direction: column; gap: 20px; align-items: flex-start; }
.atlas-scene::before { content: ""; position: absolute; inset: -10%; z-index: -2;
  background: url('fond.webp') center/cover no-repeat;
  filter: blur(30px) saturate(118%) brightness(1.04); transform: scale(1.08); }
.atlas-scene::after { content: ""; position: absolute; inset: 0; z-index: -1;
  background: linear-gradient(180deg, rgba(236,239,244,.30), rgba(226,231,240,.42)); }
.zr-dark .atlas-scene::after { background: linear-gradient(180deg, rgba(31,31,30,.58), rgba(28,28,27,.68)); }
.zr-dark .atlas-scene { color: #ECECEA; }

/* Une rangée d'échantillons, et son étiquette. */
.atlas-rangee { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; }
.atlas-etiq { width: 100%; margin: 0 0 -8px;
              font: 400 var(--zr-ui-2xs)/1 var(--zr-police-mono);
              letter-spacing: .07em; text-transform: uppercase; opacity: .55; }

/* L'ASSEMBLEUR — la porte d'entrée. */
.atlas-liste { max-width: 1180px; margin: 0 auto; display: grid;
               grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 12px; }
.atlas-carte { display: block; padding: 16px 18px; border-radius: 14px; text-decoration: none;
               background: #fdfdfc; box-shadow: 0 2px 10px -4px rgba(0,0,0,.16);
               transition: transform .14s ease, box-shadow .14s ease; }
.atlas-carte:hover { transform: translateY(-2px); box-shadow: 0 10px 26px -8px rgba(0,0,0,.24); }
.atlas-carte b { display: block; margin-bottom: 5px;
                 font: 350 var(--zr-ui-2xl)/1.25 var(--zr-police-serif); color: #1F1F1E; }
.atlas-carte span { display: block; margin-bottom: 8px;
                    font: 400 var(--zr-ui-sm)/1.45 var(--zr-police-sans); color: #6b6b67; }
.atlas-carte code { font: 400 var(--zr-ui-3xs)/1.4 var(--zr-police-mono); color: #9a9a96;
                    word-break: break-all; }
