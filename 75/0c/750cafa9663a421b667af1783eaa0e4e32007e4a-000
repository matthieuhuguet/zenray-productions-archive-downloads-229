      /* Placeholder « Enter text or type… » EN NOIR (clair) — CATCH-ALL de TOUTES les occurrences. BlockNote/
         ProseMirror l'injecte via plusieurs mécanismes : [data-is-empty-and-focused], [data-is-only-empty-block],
         [data-placeholder], .is-empty/.is-editor-empty (ProseMirror), sur le bloc OU sur .bn-inline-content,
         focus ou non. On les couvre toutes. Dark = gris clair lisible (override après). */
      .bn-editor [data-is-empty-and-focused]::before,
      .bn-editor [data-is-empty-and-focused] .bn-inline-content::before,
      .bn-editor [data-is-only-empty-block]::before,
      .bn-editor [data-is-only-empty-block] .bn-inline-content::before,
      .bn-editor [data-placeholder]::before,
      .bn-editor .bn-inline-content[data-placeholder]::before,
      .bn-editor .ProseMirror .is-empty::before,
      .bn-editor .ProseMirror .is-editor-empty::before,
      .bn-editor .ProseMirror p.is-empty:first-child::before{color:#1F1F1E!important;-webkit-text-fill-color:#1F1F1E!important;opacity:1!important}
      .zr-dark .bn-editor [data-is-empty-and-focused]::before,
      .zr-dark .bn-editor [data-is-empty-and-focused] .bn-inline-content::before,
      .zr-dark .bn-editor [data-is-only-empty-block]::before,
      .zr-dark .bn-editor [data-is-only-empty-block] .bn-inline-content::before,
      .zr-dark .bn-editor [data-placeholder]::before,
      .zr-dark .bn-editor .bn-inline-content[data-placeholder]::before,
      .zr-dark .bn-editor .ProseMirror .is-empty::before,
      .zr-dark .bn-editor .ProseMirror .is-editor-empty::before{color:rgba(235,235,235,0.55)!important;-webkit-text-fill-color:rgba(235,235,235,0.55)!important}
